# ── Avireon AI 音乐创作平台 — 环境变量配置 ──
# 复制此文件为 .env 并填写实际值后即可启动

# ===== 基础配置 =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ===== 硅基流动 SiliconFlow（文本 + 代码 + 图片） =====
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ===== OpenRouter 免费模型池 =====
# 注册地址: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_CODE_MODEL=cohere/north-mini-code:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ===== Runway MV 视频生成 =====
RUNWAY_API_KEY=your-runway-key-here
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1

# ===== Agnes 提示词优化 =====
AGNES_API_KEY=your-agnes-key-here
AGNES_API_BASE=https://api.agnes.ai/v1

# ===== GPT-SoVITS 声音克隆 (可选) =====
SOVITS_ENABLED=false
SOVITS_API_BASE=http://127.0.0.1:9880
SOVITS_DEFAULT_LANGUAGE=zh

# ===== Cloudflare R2 存储 (可选，未配置时自动使用本地存储) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_AUDIO=music-audio
R2_BUCKET_COVERS=music-covers
R2_PUBLIC_BASE_URL=

# ===== 本地存储 (R2 未配置时自动回退) =====
LOCAL_UPLOADS_DIR=data/uploads
LOCAL_BASE_URL=http://localhost:8000

# ===== 灰度管控 =====
# FEATURE_STAGE 1/2/3, 1=公测基础版，3=全量放开
FEATURE_STAGE=1

# ===== 分级限流 =====
DAILY_FREE_CREDITS=10
DAILY_MAX_AI_CALLS=10
DAILY_GLOBAL_MAX_CALLS=200
DAILY_MV_SLOTS=3
DAILY_HEAVY_FEATURE_CALLS=3
DAILY_SILICONFLOW_CALLS=100
DAILY_OPENROUTER_CALLS=200
TASK_TIMEOUT_MINUTES=30

# ===== 废弃 Key (V2.0 不再使用，保留仅作记录) =====
# DEEPSEEK_API_KEY=
# NVIDIA_API_KEY=
# GLM_API_KEY=
# SUNO_API_KEY=
# MUREKA_API_KEY=