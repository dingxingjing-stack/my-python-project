# ── Avireon V2.0 AI 音乐创作平台 — 环境变量配置 ──

# ── 基础配置 ──
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
INTERNAL_API_TOKEN=change-me
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── 硅基流动 SiliconFlow（免费模型） ──
# 注册地址: https://cloud.siliconflow.cn/
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ── OpenRouter（免费模型） ──
# 注册地址: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LONG_MODEL=nvidia/nemotron-3-ultra:free
OPENROUTER_CODE_MODEL=cohere/command-r-code:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni:free

# ── Suno 音乐生成（可选） ──
SUNO_API_BASE=
SUNO_API_KEY=

# ── Cloudflare R2 存储（可选，未配置时自动使用本地存储） ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_AUDIO=music-audio
R2_BUCKET_COVERS=music-covers
R2_PUBLIC_BASE_URL=

# ── 本地存储（R2 未配置时自动回退） ──
LOCAL_UPLOADS_DIR=data/uploads
LOCAL_BASE_URL=http://localhost:8000

# ── 免费额度管控（纯虚拟点数，不接真实充值） ──
DAILY_FREE_CREDITS=10          # 每日免费赠送 Credits（次日重置）
DAILY_MAX_AI_CALLS=10          # 单用户每日最多 AI 生成次数
DAILY_GLOBAL_MAX_CALLS=200     # 全局每日 AI 总调用上限（防免费接口限流）
DAILY_MV_SLOTS=3              # 每日 MV 免费生成名额（软限制）
REFERRAL_REWARD_CREDITS=10    # 好友完成首首歌曲奖励 Credits
REFERRAL_DAILY_REWARD_LIMIT=5  # 单用户每日邀请奖励上限
TASK_TIMEOUT_MINUTES=30        # 任务超时时间（分钟），超时自动标记 failed 并退款

# ── 废弃配置（V2.0 不再使用） ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=
# RUNWAY_API_KEY=
# RUNWAY_API_BASE=
# ── Avireon V1.0 AI 音乐创作平台 — 环境变量配置 ──

# ── 基础配置 ──
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
INTERNAL_API_TOKEN=change-me
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── 硅基流动 SiliconFlow（免费模型） ──
# 注册地址: https://cloud.siliconflow.cn/
# 免费额度: Qwen2.5-7B-Instruct 和 Qwen2.5-Coder-7B-Instruct 均免费
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ── OpenRouter（免费模型） ──
# 注册地址: https://openrouter.ai/
# 免费模型: nemotron-3-ultra:free, command-r-code:free, nemotron-3-nano-omni:free
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LONG_MODEL=nvidia/nemotron-3-ultra:free
OPENROUTER_CODE_MODEL=cohere/command-r-code:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni:free

# ── Suno 音乐生成（可选，用于音频生成） ──
SUNO_API_BASE=
SUNO_API_KEY=

# ── Cloudflare R2 存储（可选，未配置时自动使用本地存储） ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_AUDIO=music-audio
R2_BUCKET_COVERS=music-covers
R2_PUBLIC_BASE_URL=

# ── 本地存储（R2 未配置时自动回退） ──
LOCAL_UPLOADS_DIR=data/uploads
LOCAL_BASE_URL=http://localhost:8000

# ── 免费额度管控（纯虚拟点数，不接真实充值） ──
# Credits 仅做用户每日免费额度限制，不产生真实现金支出
DAILY_FREE_CREDITS=10          # 每日免费赠送 Credits（次日重置）
DAILY_MAX_AI_CALLS=10          # 单用户每日最多 AI 生成次数
DAILY_GLOBAL_MAX_CALLS=200     # 全局每日 AI 总调用上限（防免费接口限流）
DAILY_MV_SLOTS=3              # 每日 MV 免费生成名额（软限制）
REFERRAL_REWARD_CREDITS=10    # 好友完成首首歌曲奖励 Credits

# ── 旧版兼容（已废弃，V1.0 不再使用） ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# RUNWAY_API_KEY=
# RUNWAY_API_BASE=https://api.runwayml.com/v1
# ── Avireon V1.0 AI 音乐创作平台 — 环境变量配置 ──

# ── 基础配置 ──
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
INTERNAL_API_TOKEN=change-me
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── 硅基流动 SiliconFlow（免费模型） ──
# 注册地址: https://cloud.siliconflow.cn/
# 免费额度: Qwen2.5-7B-Instruct 和 Qwen2.5-Coder-7B-Instruct 均免费
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# ── OpenRouter（免费模型） ──
# 注册地址: https://openrouter.ai/
# 免费模型: nemotron-3-ultra:free, command-r-code:free, nemotron-3-nano-omni:free
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LONG_MODEL=nvidia/nemotron-3-ultra:free
OPENROUTER_CODE_MODEL=cohere/command-r-code:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3-nano-omni:free

# ── Suno 音乐生成（可选，用于音频生成） ──
SUNO_API_BASE=
SUNO_API_KEY=

# ── Cloudflare R2 存储（可选，未配置时自动使用本地存储） ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_AUDIO=music-audio
R2_BUCKET_COVERS=music-covers
R2_PUBLIC_BASE_URL=

# ── 本地存储（R2 未配置时自动回退） ──
LOCAL_UPLOADS_DIR=data/uploads
LOCAL_BASE_URL=http://localhost:8000

# ── 旧版兼容（已废弃，V1.0 不再使用） ──
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# RUNWAY_API_KEY=
# RUNWAY_API_BASE=https://api.runwayml.com/v1
# ===== AI Service Configuration =====

# --- 服务 ---
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ── CC Switch 统一中转（推荐） ──
# 开启后所有 provider 共用此 base_url + api_key，只靠 model 名区分
RELAY_API_BASE=http://127.0.0.1:你的端口/v1
RELAY_API_KEY=你的CC中转key

# ── 各 provider 在 CC Switch 上注册的 model 名 ──
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GLM_MODEL=z-ai/glm-5.2
# OPENAI_MODEL=

# ── 直连备用（仅在 RELAY_API_KEY 为空时生效） ──
# DEEPSEEK_API_KEY=...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# NVIDIA_API_KEY=...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# GLM_API_KEY=...
# GLM_BASE_URL=https://api.z.ai/v1
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Suno 音乐生成 ──
SUNO_API_BASE=https://suno.example.com/v1
SUNO_API_KEY=your-suno-key

# ── GPT-SoVITS 声音克隆 ──
SOVITS_ENABLED=false
SOVITS_API_BASE=http://127.0.0.1:9880
SOVITS_DEFAULT_LANGUAGE=zh

# ── Cloudflare R2 ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_AUDIO=music-audio
R2_BUCKET_COVERS=music-covers
R2_PUBLIC_BASE_URL=https://cdn.your-music-site.com

# ── Runway MV 生成 ──
RUNWAY_API_KEY=your-runway-key
RUNWAY_API_BASE=https://api.runwayml.com/v1

# ── 本地存储（R2 未配置时自动回退） ──
LOCAL_UPLOADS_DIR=data/uploads
LOCAL_BASE_URL=http://localhost:8000
